{
  "name": "winbridge-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local permissions, command proposals and workflow dashboard for WinBridge MCP",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env WINBRIDGE_GUI_DEV=1 electron .\"",
    "start": "electron .",
    "build": "vite build",
    "check": "node --check electron/main.mjs && node --check electron/services.mjs && node --check electron/preload.cjs && node --check ../node/src/command-requests.mjs && node --check ../node/src/control-state.mjs",
    "test": "node --test",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.winbridge.controlcenter",
    "productName": "WinBridge Control Center",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../node/src",
        "to": "node/src",
        "filter": [
          "**/*.mjs",
          "**/*.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WinBridge-Control-Center-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true
  }
}
